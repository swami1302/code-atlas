# Copy to .env and fill in real values. Never commit .env.

# Neon: direct host (no -pooler), asyncpg driver, ssl=require
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require

# Upstash: the URL only (not the redis-cli command), rediss:// = TLS
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# Google AI Studio (aistudio.google.com > Get API key): embeds chunks
GEMINI_API_KEY=YOUR_KEY

# Optional: DEBUG, INFO, WARNING, ERROR (default INFO)
# LOG_LEVEL=DEBUG
